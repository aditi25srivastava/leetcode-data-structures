class Solution(object):
    def permuteUnique(self, nums):
        """
        :type nums: List[int]
        :rtype: List[List[int]]
        """
        nums.sort()
        used = [False] * len(nums)
        result = []
        def Backtracking(path):
            if len(path) == len(nums):
                result.append(path[:])
                return
            for i in range(len(nums)):
                if used[i]:
                    continue
                if i > 0 and nums[i] == nums[i -1] and used[i-1] == False:
                    continue
                used[i] = True    
                path.append(nums[i])
                Backtracking(path)  
                path.pop()
                used[i] = False
        Backtracking([])
        return result             