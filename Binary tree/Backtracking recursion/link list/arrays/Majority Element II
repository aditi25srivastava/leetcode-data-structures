class Solution(object):
    def majorityElement(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        count1 = 0
        count2 = 0
        ele1 = float('inf')
        ele2 = float('inf')

        for num in nums:
            if num == ele1:
                count1 += 1

            elif num == ele2:
                count2 += 1

            elif count1 == 0:
                ele1 = num
                count1 += 1

            elif count2 == 0:
                ele2 = num
                count2 += 1
           
            else:
                count1 -= 1
                count2 -= 1

        count1 = 0
        count2 = 0
        for num in nums:
            if num == ele1:
                count1 += 1
            if num == ele2:
                count2 += 1
                    
        n = len(nums)
        result = []

        if count1 > n // 3:
            result.append(ele1)
        if count2 > n // 3 and ele2 != ele1:
            result.append(ele2)
            
        return result        
        




        