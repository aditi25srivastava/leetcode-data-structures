class Solution(object):
    def xorQueries(self, arr, queries):
        """
        :type arr: List[int]
        :type queries: List[List[int]]
        :rtype: List[int]
        """
        pref = [0] * (len(arr) + 1)
        for i in range(len(arr)):
            pref[i + 1] = pref[i] ^ arr[i]

        ans = []
        for left, right in queries:
            ans.append(pref[right + 1] ^ pref[left])
        return ans    
        


        