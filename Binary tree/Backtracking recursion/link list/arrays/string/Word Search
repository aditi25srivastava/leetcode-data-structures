class Solution(object):
    def exist(self, board, word):
        """
        :type board: List[List[str]]
        :type word: str
        :rtype: bool
        """
        rows = len(board)
        cols = len(board[0])

        def dfs(row,col,index):
            if index == len(word):
                return True
            if row < 0 or row >= rows or col < 0 or col >= cols or board[row][col] != word[index]:
                return False

            temp = board[row][col]
            board[row][col] = "#"

            for dr, dc in [(1,0), (-1,0),(0,1),(0,-1)]:
                if dfs(row + dr, col + dc, index + 1):
                    return True
            board[row][col] = temp
            return False
        for r in range(rows):
            for c in range(cols):
                if dfs(r, c, 0):
                    return True
        return False





    

        


    