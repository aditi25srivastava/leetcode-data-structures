class Solution(object):
    def integerReplacement(self, n):
        """
        :type n: int
        :rtype: int
        """
        operations = 0
        while n != 1:
            if n % 2 == 0:
                n = n // 2
            else:
                if n == 3:
                    n = n - 1
                elif 2 & n:
                    n = n + 1
                else:
                    n = n - 1
            operations += 1            
        return operations

    

    
       