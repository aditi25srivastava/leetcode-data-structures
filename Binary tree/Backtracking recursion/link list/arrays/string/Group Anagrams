class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        group = {}
        for word in strs:
            sortedWord = ''.join(sorted(word))    
            if sortedWord not in group:
                group[sortedWord] = []
            group[sortedWord].append(word)
        return list(group.values())        
      
