class Solution(object):
    def canPlaceFlowers(self, flowerbed, n):
        """
        :type flowerbed: List[int]
        :type n: int
        :rtype: bool
        """ 
        if n == 0:
            return True
        last = len(flowerbed) - 1
        for i in range(len(flowerbed)):
            if flowerbed[i] == 0:
                left = i == 0 or flowerbed[ i - 1] == 0
                right = i == last or flowerbed[i + 1] == 0

                if left and right:
                    flowerbed[i] = 1
                    n = n - 1
                if n == 0:
                    return True
        return False        