from collections import Counter
class Solution(object):
    def numSplits(self, s):
        """
        :type s: str
        :rtype: int
        """
        right = Counter(s)
        left = set()
        answer = 0
        n = len(s)
        for i in range(n - 1):
            ch = s[i]
            left.add(ch)
            right[ch] -= 1
            if right[ch] == 0:
                del right[ch]
            if len(left) == len(right):
                answer += 1
        return answer            

       

    