class Solution(object):
    def addBinary(self, a, b):
        """
        :type a: str
        :type b: str
        :rtype: str
        """
        i = len(a) -1
        j = len(b) - 1
        answer = []
        carry  = 0
        while i >= 0 or j >= 0 or carry == 1: # tb tk run hoga tb tk i or j m intrger h or carry 1 tb tk 
            total = carry 
            if i >= 0:
                total += int(a[i]) # total int or a[i] yeh str ch to isko bhi int krn k liye int laga h aage iske 
                i -= 1
            if j >= 0:
                total += int(b[j])
                j -= 1
            carry = total // 2    
            answer.append(str(total % 2))
            
        return "".join(answer[::-1]) 