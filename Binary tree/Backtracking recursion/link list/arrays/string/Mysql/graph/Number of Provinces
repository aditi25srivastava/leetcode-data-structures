class Solution(object):
    def findCircleNum(self, isConnected):
        """
        :type isConnected: List[List[int]]
        :rtype: int
        """
        n = len(isConnected)
        province = 0
        visited = set()
        def dfs(city):
            visited.add(city)
            for other_city in range(n):
                if isConnected[city][other_city] == 1 and other_city not in visited:
                    dfs(other_city)
        for city in range(n):
            if city not in visited:
                province += 1
                visited.add(city)
                dfs(city)   
        return province             



        