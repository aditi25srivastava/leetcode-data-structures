class Solution(object):
    def floodFill(self, image, sr, sc, color):
        """
        :type image: List[List[int]]
        :type sr: int
        :type sc: int
        :type color: int
        :rtype: List[List[int]]
        """
        rows = len(image)
        cols = len(image[0])

        original_color = image[sr][sc]
        if original_color == color:
            return image
        def dfs(row, col):
            image[row][col] = color
            if row > 0 and image[row - 1][col] == original_color:
                dfs(row - 1, col)
            if row < rows - 1 and image[row + 1][col] == original_color:
                dfs(row + 1, col)
            if col > 0 and image[row][col - 1] == original_color:
                dfs(row, col - 1)  
            if col < cols - 1 and image[row][col + 1] == original_color:
                dfs(row, col + 1)
        dfs(sr, sc)
        return image
        