class Solution(object):
    def maxNumber(self, nums1, nums2, k):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :type k: int
        :rtype: List[int]
        """
        def maxSubsequence(nums, k):

            remove = len(nums) - k
            stack = []
            for digit in nums:
                while stack and remove > 0 and stack[-1] < digit:
                    stack.pop()
                    remove -= 1
                stack.append(digit)
            return stack[:k] # Make sure we only return exactly x elements

        def merge(a, b):
            result = []
            while a or b :
    # Comparing the whole remaining lists handles tie-breakers perfectly
                if a > b:
                    result.append(a.pop(0))
                else:
                    result.append(b.pop(0))
            return result 

        answer = []
        # Figure out the valid range for k1
        start = max(0, k - len(nums2))
        end = min(k, len(nums1))
        for k1 in range(start, end + 1):
            k2 = k - k1
            # Get the best subsequences of lengths k1 and k2
            best1 = maxSubsequence(nums1, k1)
            best2 = maxSubsequence(nums2, k2)
            # Merge them and keep the best overall result
            candidate = merge(best1, best2)
            if candidate > answer:
                answer = candidate
        return answer                   

            


            

       