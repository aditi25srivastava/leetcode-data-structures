class Solution(object):
    def countAndSay(self, n):
        """
        :type n: int
        :rtype: str
        """
        res = "1"

        for _ in range(n -1):

            newRes = []
            count = 1
            for i in range(len(res)):
                if i + 1 < len(res) and res[i] == res[i + 1]:
                    count += 1
                else:
                    newRes.append(str(count))
                    newRes.append(res[i])
                    count = 1
            res =  "".join(newRes)
        return res       



    
        