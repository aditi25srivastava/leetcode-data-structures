class Solution(object):
    def candy(self, ratings):
        """
        :type ratings: List[int]
        :rtype: int
        """
        n = len(ratings)
        i = 0
        total = 1
        while i < n - 1:
            if ratings[i] == ratings[i + 1]:
                i += 1
                total += 1
                continue
            up = 0
            while i < n - 1 and ratings[i] < ratings[i+1]:
                up += 1
                total += up + 1
                i += 1
            down = 0
            while i < n - 1 and ratings[i] > ratings[i+1]:
                down += 1
                total += down
                i += 1 
            if down > up:
                total += down - up 
        return total    




    
           

        

       