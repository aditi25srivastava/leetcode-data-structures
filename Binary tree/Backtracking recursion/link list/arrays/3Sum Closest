class Solution(object):
    def threeSumClosest(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        nums.sort()
        ans = []
        n = len(nums)

        closest = nums[0] + nums[1] + nums[2]
        for i in range(n):
                
            j = i + 1
            k = n - 1
            while j < k:
                sum = nums[i] + nums[j] + nums[k]
                
                if abs(target - sum) < abs(closest - target):
                    closest = sum

                if sum < target:
                    j += 1
                elif sum > target:
                    k -= 1
                else: 
                    return sum

        return closest            
                    

                    