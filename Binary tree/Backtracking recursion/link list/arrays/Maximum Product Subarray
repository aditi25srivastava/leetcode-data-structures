class Solution(object):
    def maxProduct(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        if not nums:
            return
        cur_max = nums[0]
        cur_min = nums[0]
        ans = nums[0]
        for i in range(1, len(nums)):
            if nums[i] < 0:
                cur_max, cur_min = cur_min, cur_max
            cur_max = max(nums[i], nums[i] * cur_max)
            cur_min = min(nums[i], nums[i] * cur_min)
            ans = max(ans, cur_max)
        return ans