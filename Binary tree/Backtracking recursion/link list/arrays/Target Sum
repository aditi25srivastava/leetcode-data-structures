class Solution(object):
    def findTargetSumWays(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        memo = {}
        def dfs(index, curSum):
            if (index, curSum) in memo:
                return memo[(index, curSum)]
            if index == len(nums):
                if curSum == target:
                    return 1
                return 0
            positive = dfs(index + 1, curSum + nums[index])   
            negative = dfs(index + 1, curSum - nums[index])
            memo[(index, curSum)] = positive + negative
            return memo[(index, curSum)]
        return dfs(0, 0)